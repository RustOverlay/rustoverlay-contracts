<Project Sdk="Microsoft.NET.Sdk">

  <!-- netstandard2.0 rather than the agent's net9.0: a schema package outlives the consumer it was
       written for, and Google.Protobuf still targets it. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- protoc's output is not our code and will never be warning-clean. -->
    <NoWarn>$(NoWarn);CS8981;CS0612;CS0618</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>RustOverlay.Contracts</PackageId>
    <!-- Overridden by CI from the git tag; this default only ever ships to a local feed. -->
    <Version>0.0.0-dev</Version>
    <Authors>RustOverlay</Authors>
    <Description>Wire contract between the RustOverlay agent and the relay. Generated from the canonical .proto.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/RustOverlay/rustoverlay-contracts</PackageProjectUrl>
    <RepositoryUrl>https://github.com/RustOverlay/rustoverlay-contracts</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Tools" Version="2.67.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\proto\**\*.proto" ProtoRoot="..\..\proto" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <!-- The .proto travels inside the package too. The agent is public so its users can audit what
         leaves the machine; that argument needs the schema to be readable from the artifact, not
         only from a repo they have to know to go and find. -->
    <None Include="..\..\proto\**\*.proto" Pack="true" PackagePath="proto\" />
  </ItemGroup>

</Project>
